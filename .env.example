# ---------------------------------------------------------------------------
# Placement Cell Portal -- environment
#
#   cp .env.example .env
#
# Every value here has a working default in config/settings.py, so a local
# run needs no .env at all. Copy it when you want Postgres, real email, or
# S3 storage.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-before-deploying-anywhere
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
LOG_LEVEL=INFO
TIME_ZONE=Asia/Kolkata

# --- Database --------------------------------------------------------------
# Unset -> SQLite at backend/db.sqlite3 (zero setup, the default for local dev).
# docker-compose sets the Postgres URL below for you.
# DATABASE_URL=postgres://placement:placement@localhost:5432/placement

# --- File storage ----------------------------------------------------------
# local -> backend/media/ ; s3 -> any S3-compatible bucket (AWS, MinIO, R2)
STORAGE_BACKEND=local
MEDIA_ROOT=
MAX_UPLOAD_BYTES=5242880
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=placement-uploads
# AWS_S3_ENDPOINT_URL=          # set for MinIO/R2; leave blank for real AWS
# AWS_S3_REGION_NAME=ap-south-1

# --- Email / OTP delivery --------------------------------------------------
# Console backend prints OTP emails to the server log -- no SMTP account needed.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=placements@college.edu
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# --- Signup / OTP policy ---------------------------------------------------
ALLOWED_STUDENT_EMAIL_DOMAINS=college.edu
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_WINDOW=3
OTP_RATE_WINDOW_MINUTES=15
OTP_THROTTLE_RATE=10/hour
ANON_THROTTLE_RATE=60/hour
# Echoes the OTP in the signup API response. Convenience for driving the
# prototype UI; forced off whenever DJANGO_DEBUG is false.
EXPOSE_OTP_IN_RESPONSE=true

# --- Matching engine -------------------------------------------------------
# auto  -> spaCy when en_core_web_md is installed, else TF-IDF
# spacy -> require spaCy (fail loudly if the model is missing)
# tfidf -> always TF-IDF
MATCHING_BACKEND=auto
SPACY_MODEL=en_core_web_md
# Leave blank to use the live backend's own suggested threshold
# (spaCy content-word cosine ~0.85, TF-IDF cosine ~0.10 -- different scales).
# DEFAULT_SIMILARITY_THRESHOLD=

# --- Resume intelligence: Llama via Ollama ---------------------------------
# LLM_BASE_URL MUST be a college-controlled Ollama server: localhost in
# development, the private server in production. Never a third-party API --
# resumes do not leave the college (RESUME_INTELLIGENCE_PLAN.md §2).
# Off by default: the portal runs on regex extraction alone.
#   docker compose --profile llm up      (or: ollama serve)
#   ollama pull llama3.1:8b && ollama pull nomic-embed-text
LLM_ENABLED=false
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=60
# Per-user limit shared by search, score, me/match and me/resume/analyze.
# Counts per worker process unless a shared CACHES (Redis/Memcached) is set.
MATCHING_THROTTLE_RATE=30/hour
# One `me/resume/analyze` request's whole budget (reply, retry, embedding).
# Keep it below the server's request timeout; past it the reading falls back
# to regex and can be retried, or backfilled with `manage.py analyze_resumes`.
RESUME_ANALYSIS_TIME_BUDGET_SECONDS=25
# An unknown skill this close (embedding cosine) to a canonical one becomes a
# pending alias suggestion for an admin. Retune when EMBED_MODEL changes.
SKILL_ALIAS_SUGGESTION_THRESHOLD=0.85

# --- Profile vectors --------------------------------------------------------
# auto  -> MongoDB when MONGO_URI is set and reachable, else a local table
# mongo -> require MongoDB;  local -> never use MongoDB
#   docker compose --profile vectors up
#   python manage.py init_vector_index
VECTOR_STORE_BACKEND=auto
# MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=placement
MONGO_VECTOR_COLLECTION=profile_vectors
MONGO_VECTOR_INDEX=profile_vector_index

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Frontend --------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_PROXY=http://127.0.0.1:8000
